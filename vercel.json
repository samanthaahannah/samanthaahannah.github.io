{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/404.html",
      "has": [
        {
          "type": "header",
          "key": "x-not-found-fallback",
          "value": "1"
        }
      ]
    },
    {
      "source": "/((?!api/|static/|assets/).*)",
      "destination": "/404.html"
    }
  ]
}
